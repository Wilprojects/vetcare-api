@baseUrl = https://localhost:7001
@token = PASTE_JWT_HERE

### API information

GET {{baseUrl}}/
Accept: application/json


### Health

GET {{baseUrl}}/health
Accept: application/json


### Register customer

POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "firstName": "Carlos",
  "lastName": "Ramirez",
  "email": "carlos@vetcare.local",
  "phoneNumber": "+51987654321",
  "password": "CHANGE_THIS_LOCAL_PASSWORD"
}


### Login

POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "carlos@vetcare.local",
  "password": "CHANGE_THIS_LOCAL_PASSWORD"
}


### Current user - without token

GET {{baseUrl}}/api/v1/auth/me
Accept: application/json


### Current user - authenticated

GET {{baseUrl}}/api/v1/auth/me
Accept: application/json
Authorization: Bearer {{token}}


### =========================================================
### PETS
### =========================================================

@petId = REPLACE_WITH_PET_ID


### Get pets

GET {{baseUrl}}/api/v1/pets
Accept: application/json
Authorization: Bearer {{token}}


### Get pets - pagination, filter and sorting

GET {{baseUrl}}/api/v1/pets?pageNumber=1&pageSize=10&species=Dog&sortBy=name&sortDirection=asc
Accept: application/json
Authorization: Bearer {{token}}


### Get pets - include inactive

GET {{baseUrl}}/api/v1/pets?pageNumber=1&pageSize=10&includeInactive=true
Accept: application/json
Authorization: Bearer {{token}}


### Get pet by id

GET {{baseUrl}}/api/v1/pets/{{petId}}
Accept: application/json
Authorization: Bearer {{token}}


### Create pet

POST {{baseUrl}}/api/v1/pets
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Luna",
  "species": "Dog",
  "breed": "Labrador",
  "sex": "Female",
  "birthDate": "2022-05-10",
  "weightKg": 24.50
}


### Update pet

PUT {{baseUrl}}/api/v1/pets/{{petId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Luna",
  "species": "Dog",
  "breed": "Labrador Retriever",
  "sex": "Female",
  "birthDate": "2022-05-10",
  "weightKg": 25.10
}


### Deactivate pet

DELETE {{baseUrl}}/api/v1/pets/{{petId}}
Authorization: Bearer {{token}}


### =========================================================
### VETERINARY SERVICES - PUBLIC
### =========================================================

@veterinaryServiceId = REPLACE_WITH_SERVICE_ID


### Get active veterinary services

GET {{baseUrl}}/api/v1/veterinary-services
Accept: application/json


### Get active veterinary services with pagination

GET {{baseUrl}}/api/v1/veterinary-services?pageNumber=1&pageSize=10&sortBy=name&sortDirection=asc
Accept: application/json


### Search veterinary services

GET {{baseUrl}}/api/v1/veterinary-services?search=consulta
Accept: application/json


### Get veterinary service by id

GET {{baseUrl}}/api/v1/veterinary-services/{{veterinaryServiceId}}
Accept: application/json


### =========================================================
### VETERINARY SERVICES - ADMIN
### =========================================================


### Get all veterinary services as admin

GET {{baseUrl}}/api/v1/admin/veterinary-services?pageNumber=1&pageSize=10&includeInactive=true
Accept: application/json
Authorization: Bearer {{token}}


### Create veterinary service

POST {{baseUrl}}/api/v1/veterinary-services
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Ecografía veterinaria",
  "description": "Evaluación mediante ecografía para diagnóstico veterinario.",
  "durationMinutes": 45,
  "price": 120.00
}


### Update veterinary service

PUT {{baseUrl}}/api/v1/veterinary-services/{{veterinaryServiceId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Ecografía veterinaria",
  "description": "Evaluación ecográfica especializada para mascotas.",
  "durationMinutes": 60,
  "price": 140.00
}


### Deactivate veterinary service

DELETE {{baseUrl}}/api/v1/veterinary-services/{{veterinaryServiceId}}
Authorization: Bearer {{token}}